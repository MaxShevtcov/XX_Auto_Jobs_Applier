{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "permission": {
    "edit": {
      "*": "allow",
      "data_folder/secrets/**": "deny",
      "data_folder/output/**": "ask",
      "chrome_profile/**": "deny",
      "logs/**": "deny"
    },
    "bash": {
      "*": "allow",
      "*secrets.yaml*": "ask"
    }
  }
}
